# ---------------------------------------------------------------------------
# Cr3dX environment. Copy to `.env` and fill in. `.env` is git-ignored.
# Never commit private keys or seed phrases.
# ---------------------------------------------------------------------------

# Creditcoin3 Testnet, chain id 102031 (deployment target)
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Creditcoin Substrate JSON-RPC endpoint. Same node, used for pallet storage
# and runtime API reads that the EVM layer does not expose.
CREDITCOIN_SUBSTRATE_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Attestcoin proof builder service
CREDITCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Ethereum Sepolia, chain id 11155111 (source chain)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Source chain EVM chain id. Used only to look the chain up in the Creditcoin
# registry; the on-chain identifier is chainKey, which is resolved at runtime.
SOURCE_EVM_CHAIN_ID=11155111

# --- probe tuning (optional, defaults in scripts/lib/config.ts) ------------
# PROBE_LAG_SAMPLES=20
# PROBE_LAG_INTERVAL_MS=45000
# PROBE_BATCH_MAX=10

# --- deployment (needed from W2 on, not used by the probe) ----------------
# Deployer private key. Read from here only. Never printed, never committed.
# DEPLOYER_PRIVATE_KEY=
