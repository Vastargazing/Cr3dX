{
  "name": "cr3dx",
  "version": "0.1.0",
  "private": true,
  "description": "Cr3dX - verified cross-chain credit layer on Creditcoin, settled on Ethereum Sepolia",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "wallets:create": "node --import tsx scripts/create-wallets.ts",
    "preflight": "node --import tsx scripts/preflight.ts",
    "probe": "node --import tsx scripts/probe.ts",
    "typecheck": "tsc --noEmit",
    "capture:fixtures": "node --import tsx scripts/capture-fixtures.ts",
    "build": "forge build",
    "test": "forge test",
    "deploy:sepolia": "node --import tsx scripts/deploy-gateway.ts",
    "deploy:gateway": "npm run deploy:sepolia",
    "capture:gate": "node --import tsx scripts/capture-gate-fixtures.ts",
    "deploy:creditcoin": "node --import tsx scripts/deploy-verifier.ts",
    "deploy:verifier": "npm run deploy:creditcoin",
    "deploy:deals": "node --import tsx scripts/deploy-deals.ts",
    "verify:live": "node --import tsx scripts/verify-live.ts",
    "deal:live": "node --import tsx scripts/deal-live.ts",
    "s5:fresh": "node --import tsx scripts/deal-live.ts --mode fresh --runs 2",
    "s5:continue": "node --import tsx scripts/deal-live.ts --mode continue --runs 1",
    "s5:resume": "node --import tsx scripts/deal-live.ts --mode continue --resume-deal",
    "worker": "worker/launch.sh",
    "worker:bootstrap": "worker/launch.sh bootstrap",
    "worker:step": "worker/launch.sh step",
    "test:worker": "node --import tsx --test --test-concurrency=1 worker/*.test.ts",
    "test:scripts": "node --import tsx --test --test-concurrency=1 scripts/lib/*.test.ts worker/*.test.ts",
    "ui:dev": "vite ui",
    "ui:build": "vite build ui",
    "ui:preview": "vite preview ui",
    "ui:typecheck": "tsc --project ui/tsconfig.json --noEmit",
    "test:ui": "node --import tsx --test --test-concurrency=1 ui/test/*.test.ts"
  },
  "dependencies": {
    "@gluwa/usc-sdk": "^0.18.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5"
  },
  "devDependencies": {
    "@polkadot/util": "^13.2.3",
    "@polkadot/util-crypto": "^13.2.3",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  }
}
